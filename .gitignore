*.sublime-workspace

# Archivos temporales de exportación y datos
*.csv
*.xlsx
*.xls
# ...pero los fixtures binarios de los tests SÍ se versionan: el .xls BIFF de
# tests/fixtures es un archivo real generado con LibreOffice (no se puede
# recrear en CI sin la suite de oficina) y es lo único que prueba la lectura
# de Excel 97-2003; el .xlsx de contrato fija los tipos, fechas, combinadas y
# la hoja de gráfico que la lectura debe soportar.
!tests/fixtures/*.xls
!tests/fixtures/*.xlsx

# Windows
*.lnk

# ---------------------------------------------------
# Archivos específicos de Cat_flip que NO deben subir
# ---------------------------------------------------

# Respaldos y copias locales
*-respaldo.*
*.bak
*~

# Contexto local/privado para IAs
/context/

# Historiales de R
.Rhistory
.RData

# Cobertura de tests
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Node (gate de axe en CI, F3.4)
node_modules/
violations.json

# Licencia premium local (Open Core) — nunca subir
premium.key

# Herramientas de packaging (descargadas y verificadas por hash pina)
packaging/appimage/tools/

# Adjuntos de las conversaciones (pueden traer secretos pegados)
.cloud-attachments/
